{
  "threshold": 1.0,
  "reporters": ["console"],
  "path": ["web/src", "scripts"],
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*_test.py",
    "**/test_*.py",
    "**/__tests__/**",
    "**/*.css",
    "**/node_modules/**"
  ],
  "format": ["typescript", "tsx", "javascript", "python"],
  "minLines": 10,
  "minTokens": 50,
  "gitignore": true
}
