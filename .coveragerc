# Coverage.py configuration for scripts/validate-marketplace.py.
#
# The Python Unit Tests workflow (`.github/workflows/python-unit-tests.yml`)
# enforces `coverage report --fail-under=100 --include='scripts/validate-marketplace.py'`.
# Without this config file, branch coverage of that script sits at 99.91%
# because of ONE unreachable partial branch, causing the required check to
# fail on every PR touching `scripts/**` or `tests/**`. See kubestellar/console-marketplace#620.
#
# The single excluded pattern below is a defensive `if console_path:` at the
# start of the nightly-checks block in main(), which is dead relative to the
# CLI contract: the argparse guard at the top of main() already `sys.exit(1)`s
# when `--mode full` is used without `--console-path`, so control can only
# reach this line with `console_path` truthy. `coverage --branch` has no way
# to exercise the false arm, so it must be excluded to reach 100%.
#
# This file is opt-in — coverage.py automatically picks it up from the repo
# root during the workflow's `python -m coverage run ...` step. No changes to
# scripts/validate-marketplace.py, tests/, or CI workflow are required.

[run]
branch = True
source = scripts

[report]
# Per-line/pragma exclusions in addition to the default `pragma: no cover`.
exclude_also =
    # Unreachable false arm of `if console_path:` inside `if args.mode == "full":`
    # — the earlier `if args.mode in ("cross-repo", "full") and not args.console_path: sys.exit(1)`
    # in main() guarantees console_path is truthy at that point. See marketplace#620.
    ^\s*if console_path:$

# When a branch is fully excluded from execution, coverage still reports it
# as partial unless we mark it here. Kept narrow — this matches the same
# single-line pattern excluded above.
partial_branches =
    ^\s*if console_path:$
