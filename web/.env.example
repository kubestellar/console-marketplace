# Example Vite environment flags for marketplace cards.
# Copy the lines you need into your Console web/.env.local (Vite only exposes
# variables prefixed with VITE_ to client code).

# OpenYurt status card: set to "true" to fetch live data through the gateway
# on mount and on refetch. Any other value (or unset) keeps the card on its
# initialData/demo stub behaviour.
# See web/src/components/cards/openyurt_status/useOpenYurtStatus.ts.
VITE_OPENYURT_LIVE_FETCH=false
