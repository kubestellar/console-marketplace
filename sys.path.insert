# scripts/validate_marketplace/results.py
import sys

class Results:
    def __init__(self):
        self.errors = 0
        self.warnings = 0

    def error(self, msg):
        print(f"❌ ERROR: {msg}", file=sys.stderr)
        self.errors += 1

    def warning(self, msg):
        print(f"⚠️  WARNING: {msg}", file=sys.stderr)
        self.warnings += 1

    def success(self, msg):
        print(f"✅ {msg}")


# scripts/validate-marketplace.py (Thin CLI wrapper)
#!/usr/bin/env python3
"""
Thin wrapper for validate_marketplace package.
Maintains backwards compatibility for CI workflows and existing test imports.
"""

import sys
import argparse
from pathlib import Path

# Ensure package is importable
SCRIPT_DIR = Path(__file__).parent.resolve()
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from validate_marketplace import *

def main():
    parser = argparse.ArgumentParser(description="Validate marketplace cards, dashboards, presets, and themes.")
    parser.add_argument("--dir", default=".", help="Root directory of console-marketplace repository")
    parser.add_argument("--strict", action="store_true", help="Treat warnings as errors")
    args = parser.parse_args()

    results = Results()
    
    # Run validations
    print("Running marketplace validation checks...")
    # (Invocation of core checks orchestrator...)
    
    if results.errors > 0 or (args.strict and results.warnings > 0):
        sys.exit(1)
    sys.exit(0)

if __name__ == "__main__":
    main()